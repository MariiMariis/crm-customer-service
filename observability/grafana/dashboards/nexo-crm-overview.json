{
  "uid": "nexo-crm-overview",
  "title": "Nexo CRM - Visao geral",
  "tags": [
    "nexo-crm",
    "microsservicos"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
